# Hugging Face Token (Write access) — Bắt buộc nếu push_to_hub=True
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# (Tùy chọn) Weights & Biases API Key — để tracking experiments
WANDB_API_KEY=
